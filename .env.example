# Google Apps Script Web App URL. Configure the real value in Netlify.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID_HERE/exec
# Resend API key. Keep the real value server-side and mark it secret in Netlify.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use a sender address on a domain verified in Resend.
RESEND_FROM_EMAIL=Hotel Orchid <enquiries@your-verified-domain.example>
# Business inbox that receives website enquiries.
ENQUIRY_RECEIVER_EMAIL=you@example.com
